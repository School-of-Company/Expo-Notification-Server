# 운영/개발 환경에서는 config-server(`GET {CONFIG_SERVER_URL}/configs/{CONFIG_SERVICE_NAME}/{CONFIG_PROFILE}`)의
# 값이 이 파일의 값보다 우선한다. CONFIG_SERVER_URL이 비어 있으면 아래 env만 사용한다.
CONFIG_SERVER_URL=
CONFIG_SERVICE_NAME=notification
CONFIG_PROFILE=local

PORT=3000

# 콤마로 구분한 Kafka 브로커 목록 — docker-compose.yml 기본값
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=expo-notification-server
KAFKA_SMS_GROUP_ID=expo-notification-server.sms
KAFKA_ALARM_GROUP_ID=expo-notification-server.alarm
KAFKA_SMS_REQUESTED_TOPIC=notification.sms.requested
# 재시도 상한을 넘은 SMS 이벤트를 원본 그대로 보관하는 토픽 (수동 재처리용)
KAFKA_SMS_DEAD_LETTER_TOPIC=notification.sms.requested.dlq
KAFKA_EXPO_APPLICANT_COUNT_TOPIC=expo.applicant-count.updated

# Eureka 등록 (Gateway가 /sms 를 expo-notification-server 로 라우팅). 비워 두면 등록하지 않는다 — 로컬 개발은 그대로 두면 된다.
EUREKA_SERVICE_URL=
EUREKA_HEARTBEAT_INTERVAL_SECONDS=
EUREKA_LEASE_DURATION_SECONDS=
EUREKA_REQUEST_TIMEOUT_MS=
# Eureka에 알릴 이 인스턴스의 호스트명/IP. 비우면 os.hostname()과 첫 번째 외부 IPv4를 쓴다
INSTANCE_HOSTNAME=
INSTANCE_IP_ADDR=

# QR 문자(User 등록 완료 이벤트)와 설문 문자(Attention 입장 이벤트)가 쓰는 토픽
KAFKA_PARTICIPANT_REGISTERED_TOPIC=user.participant.registered
KAFKA_ENTRY_RECORDED_TOPIC=attention.entry.recorded

# Attention 내부 API(POST /internal/qr-images) 주소(끝에 / 없이)와 공유 시크릿(X-Internal-Token) 사본. 32자 이상, 값은 여기 적지 않는다
ATTENTION_SERVICE_URL=http://localhost:8081
ATTENTION_SERVICE_INTERNAL_TOKEN=
# User 내부 API(POST /internal/participants/sms-try) 주소와 공유 시크릿 사본. 32자 이상
USER_SERVICE_URL=http://localhost:8080
USER_SERVICE_INTERNAL_TOKEN=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Solapi(CoolSMS) — 운영에서는 Vault secret/notification 에서 받는다
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_STANDARD_NUMBER=
SMS_FROM_TRAINEE_NUMBER=
# 문자 본문에 들어가는 행사명, 문의 번호(없으면 문의 줄 생략)
SMS_EXPO_NAME=박람회
SMS_CONTACT_STANDARD_NUMBER=
SMS_CONTACT_TRAINEE_NUMBER=
# 입장 설문 문자의 링크. {expoId}가 박람회 ID로 바뀐다. 최종 프론트 주소가 정해지기 전에는 비워 두면 설문 문자를 보내지 않는다
SMS_SURVEY_URL_TEMPLATE=
# 인증번호 유효시간(초) / 유효시간 내 발송 상한 / 검증 시도 상한
SMS_AUTH_CODE_TTL_SECONDS=180
SMS_AUTH_MAX_SEND_COUNT=5
# 인증번호 문자 전체 시간당 발송 상한 (문자 비용 폭주 차단기)
SMS_AUTH_MAX_SEND_COUNT_PER_HOUR=300
# 같은 SMS 이벤트 처리 실패를 이만큼 반복하면 DLQ로 보낸다
SMS_EVENT_MAX_ATTEMPTS=5
SMS_AUTH_MAX_VERIFY_ATTEMPT_COUNT=5

# 등록 인원 리포트를 받을 Discord 웹훅 URL. 비어 있으면 리포트를 보내지 않는다
DISCORD_PARTICIPANT_NUMBER_URL=
